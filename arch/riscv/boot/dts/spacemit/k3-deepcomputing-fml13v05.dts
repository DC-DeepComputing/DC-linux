#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

#include "k3.dtsi"
#include "k3-display.dtsi"
#include "k3-pinctrl.dtsi"

/ {
	model = "DeepComputing FML13V05";
	compatible = "deepcomputing,fml13v05", "spacemit,k3";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@100000000 {
		device_type = "memory";
		reg = <0x1 0x00000000 0x4 0x00000000>;
	};

	reg_aux_vcc3v3: regulator-aux-vcc3v3 {
		compatible = "regulator-fixed";
		regulator-name = "AUX_VCC3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_aux_vcc5v: regulator-aux-vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "AUX_VCC5V";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	reg_wlan_3v3: regulator-wlan-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "WLAN_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio K3_GPIO(41) GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	rfkill-pcie-wlan {
		compatible = "rfkill-gpio";
		label = "rfkill-pcie-wlan";
		radio-type = "wlan";
		shutdown-gpios = <&gpio K3_GPIO(35) GPIO_ACTIVE_HIGH>;
	};

	rfkill-usb-bt {
		compatible = "rfkill-gpio";
		label = "rfkill-usb-bt";
		radio-type = "bluetooth";
		shutdown-gpios = <&gpio K3_GPIO(30) GPIO_ACTIVE_HIGH>;
	};
};

&i2c8 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c8_cfg>;
	status = "okay";

	p1@41 {
		compatible = "spacemit,p1";
		reg = <0x41>;
		interrupts = <64 IRQ_TYPE_LEVEL_HIGH>;
		vin1-supply = <&reg_aux_vcc5v>;
		vin2-supply = <&reg_aux_vcc5v>;
		vin3-supply = <&reg_aux_vcc5v>;
		vin4-supply = <&reg_aux_vcc5v>;
		vin5-supply = <&reg_aux_vcc5v>;
		vin6-supply = <&reg_aux_vcc5v>;
		aldoin-supply = <&reg_aux_vcc5v>;
		dldoin1-supply = <&buck4>;
		dldoin2-supply = <&buck4>;

		regulators {
			buck1: buck1 {
				regulator-min-microvolt = <1050000>;
				regulator-max-microvolt = <1050000>;
				regulator-ramp-delay = <5000>;
				regulator-always-on;
			};

			buck2: buck2 {
				regulator-min-microvolt = <1050000>;
				regulator-max-microvolt = <1050000>;
				regulator-ramp-delay = <5000>;
				regulator-always-on;
			};

			buck3: buck3 {
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <800000>;
				regulator-ramp-delay = <5000>;
				regulator-always-on;
			};

			buck4: buck4 {
				regulator-min-microvolt = <2100000>;
				regulator-max-microvolt = <2100000>;
				regulator-ramp-delay = <5000>;
				regulator-always-on;
			};

			buck5: buck5 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-ramp-delay = <5000>;
				regulator-always-on;
			};

			buck6: buck6 {
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <500000>;
				regulator-ramp-delay = <5000>;
				regulator-always-on;
			};

			aldo1: aldo1 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			aldo2: aldo2 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			aldo3: aldo3 {
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <3400000>;
			};

			aldo4: aldo4 {
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dldo1: dldo1 {
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dldo2: dldo2 {
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dldo3: dldo3 {
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dldo4: dldo4 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
			};

			dldo5: dldo5 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dldo6: dldo6 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};

			dldo7: dldo7 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};
};

&combophy {
	spacemit,apmu = <&syscon_apmu 0x17>;
	status = "okay";
};

&sdhci0 {
	pinctrl-names = "default","uhs";
	pinctrl-0 = <&mmc1_cfg>;
	pinctrl-1 = <&mmc1_uhs_cfg>;
	bus-width = <4>;
	cd-gpios = <&gpio K3_GPIO(88) GPIO_ACTIVE_LOW>;
	no-mmc;
	no-sdio;
	disable-wp;
	cap-sd-highspeed;
	vmmc-supply = <&aldo4>;
	vqmmc-supply = <&aldo1>;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	status = "okay";
};

&pcie0_rc {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_0_cfg>;
	num-lanes = <4>;
	status = "okay";

	pcie@0 {
		vpcie3v3-supply = <&reg_aux_vcc3v3>;
		phys = <&combophy 0 PHY_TYPE_PCIE>,
		       <&combophy 1 PHY_TYPE_PCIE>;
	};
};

&pcie4_rc {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie4_0_cfg>;
	num-lanes = <1>;
	status = "okay";

	pcie@0 {
		vpcie3v3-supply = <&reg_aux_vcc3v3>;
		phys = <&combophy 5 PHY_TYPE_PCIE>;
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_0_cfg>;
	status = "okay";
};

&ufshc {
	status = "okay";
};

&usb2_host {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	hub@1 {
		compatible = "usb5e3,608";
		reg = <1>;
	};
};

&usb2_phy {
	status = "okay";
};

&usb3b_u2phy {
	status = "okay";
};

&usb3b {
	phys = <&usb3b_u2phy>, <&combophy 2 PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
	status = "okay";
};

&usb3c_u2phy {
	status = "okay";
};

&usb3c {
	phys = <&usb3c_u2phy>, <&combophy 3 PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
	status = "okay";
};

&usb3d_u2phy {
	status = "okay";
};

&usb3d {
	phys = <&usb3d_u2phy>, <&combophy 4 PHY_TYPE_USB3>;
	phy-names = "usb2-phy", "usb3-phy";
	status = "okay";
};
/*
 * The FML13V05 routes the second SoC display path (DPU1/DP1) to the
 * external DisplayPort receptacle and the first one (DPU0/eDP0) to the
 * built-in 13.3" eDP panel. Enable both DPUs and their downstream
 * DisplayPort controllers.
 */

&dpu0_crtc0 {
	status = "okay";
};

&edp0 {
	pinctrl-names = "default";
	pinctrl-0 = <&edp0_1_cfg>;
	status = "okay";
};

&dpu1_crtc0 {
	status = "okay";
};

&dp1 {
	pinctrl-names = "default";
	pinctrl-0 = <&dp1_1_cfg>;
	status = "okay";
};

&espi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&espi0_2_cfg>;
	status = "okay";
};

&ec {
	interrupt-parent = <&gpio>;
	interrupts = <1 11 IRQ_TYPE_EDGE_RISING>;
	status = "okay";

	keyboard-controller {
		compatible = "google,cros-ec-keyb";
		keypad,num-rows = <8>;
		keypad,num-columns = <16>;
		linux,keymap = <
		/* Row 0 */
		MATRIX_KEY(0x00, 0x00, KEY_C)           /* ID: 48 */
		MATRIX_KEY(0x00, 0x01, KEY_DELETE)      /* ID: 76 */
		MATRIX_KEY(0x00, 0x02, KEY_Q)           /* ID: 17 */
		MATRIX_KEY(0x00, 0x03, KEY_RIGHTALT)    /* ID: 62 */
		MATRIX_KEY(0x00, 0x05, KEY_X)           /* ID: 47 */
		MATRIX_KEY(0x00, 0x06, KEY_V)           /* ID: 49 */
		MATRIX_KEY(0x00, 0x07, KEY_M)           /* ID: 52 */
		MATRIX_KEY(0x00, 0x08, KEY_DOT)         /* ID: 54 */
		MATRIX_KEY(0x00, 0x09, KEY_RIGHTSHIFT)  /* ID: 57 */
		MATRIX_KEY(0x00, 0x0a, KEY_COMMA)       /* ID: 53 */
		MATRIX_KEY(0x00, 0x0c, KEY_RIGHTCTRL)   /* ID: 64 */
		MATRIX_KEY(0x00, 0x0d, KEY_SLASH)       /* ID: 55 */
		MATRIX_KEY(0x00, 0x0e, KEY_APOSTROPHE)  /* ID: 41 (' ) */

		/* Row 1 */
		MATRIX_KEY(0x01, 0x03, KEY_LEFTALT)     /* ID: 60 */
		MATRIX_KEY(0x01, 0x04, KEY_SPACE)       /* ID: 61 */
		MATRIX_KEY(0x01, 0x05, KEY_Z)           /* ID: 46 */
		MATRIX_KEY(0x01, 0x06, KEY_B)           /* ID: 50 */
		MATRIX_KEY(0x01, 0x07, KEY_N)           /* ID: 51 */
		MATRIX_KEY(0x01, 0x08, KEY_DOWN)        /* ID: 84-1 */
		MATRIX_KEY(0x01, 0x09, KEY_LEFTSHIFT)   /* ID: 44 */
		MATRIX_KEY(0x01, 0x0c, KEY_LEFTCTRL)    /* ID: 58 */
		MATRIX_KEY(0x01, 0x0d, KEY_UP)          /* ID: 83-1 */
		MATRIX_KEY(0x01, 0x0e, KEY_ENTER)       /* ID: 43 */
		MATRIX_KEY(0x01, 0x0f, KEY_F8)          /* ID: 119 */

		/* Row 2 */
		MATRIX_KEY(0x02, 0x02, KEY_FN)          /* ID: 59 */
		MATRIX_KEY(0x02, 0x04, KEY_E)           /* ID: 19 */
		MATRIX_KEY(0x02, 0x05, KEY_F2)          /* ID: 113 */
		MATRIX_KEY(0x02, 0x06, KEY_G)           /* ID: 35 */
		MATRIX_KEY(0x02, 0x07, KEY_H)           /* ID: 36 */
		MATRIX_KEY(0x02, 0x08, KEY_BACKSLASH)   /* ID: 29/42 */
		MATRIX_KEY(0x02, 0x0a, KEY_F7)          /* ID: 118 */
		MATRIX_KEY(0x02, 0x0d, KEY_MINUS)       /* ID: 12 */
		MATRIX_KEY(0x02, 0x0f, KEY_RIGHT)       /* ID: 89-1 */

		/* Row 3 */
		MATRIX_KEY(0x03, 0x01, KEY_LEFTMETA)    /* ID: 127 (Win) */
		MATRIX_KEY(0x03, 0x02, KEY_TAB)         /* ID: 16 */
		MATRIX_KEY(0x03, 0x04, KEY_F4)          /* ID: 115 */
		MATRIX_KEY(0x03, 0x05, KEY_F1)          /* ID: 112 */
		MATRIX_KEY(0x03, 0x06, KEY_T)           /* ID: 21 */
		MATRIX_KEY(0x03, 0x07, KEY_Y)           /* ID: 22 */
		MATRIX_KEY(0x03, 0x08, KEY_O)           /* ID: 25 */
		MATRIX_KEY(0x03, 0x0a, KEY_F6)          /* ID: 117 */
		MATRIX_KEY(0x03, 0x0b, KEY_F9)          /* ID: 120 */
		MATRIX_KEY(0x03, 0x0d, KEY_F12)         /* ID: 123 */

		/* Row 4 */
		MATRIX_KEY(0x04, 0x02, KEY_GRAVE)       /* ID: 1 (~) */
		MATRIX_KEY(0x04, 0x04, KEY_CAPSLOCK)    /* ID: 30 */
		MATRIX_KEY(0x04, 0x05, KEY_S)           /* ID: 32 */
		MATRIX_KEY(0x04, 0x06, KEY_5)           /* ID: 6 */
		MATRIX_KEY(0x04, 0x07, KEY_6)           /* ID: 7 */
		MATRIX_KEY(0x04, 0x08, KEY_F10)         /* ID: 121 */
		MATRIX_KEY(0x04, 0x0a, KEY_F5)          /* ID: 116 */
		MATRIX_KEY(0x04, 0x0d, KEY_0)           /* ID: 11 */
		MATRIX_KEY(0x04, 0x0e, KEY_EQUAL)       /* ID: 13 */

		/* Row 5 */
		MATRIX_KEY(0x05, 0x02, KEY_1)           /* ID: 2 */
		MATRIX_KEY(0x05, 0x04, KEY_3)           /* ID: 4 */
		MATRIX_KEY(0x05, 0x05, KEY_2)           /* ID: 3 */
		MATRIX_KEY(0x05, 0x06, KEY_4)           /* ID: 5 */
		MATRIX_KEY(0x05, 0x07, KEY_7)           /* ID: 8 */
		MATRIX_KEY(0x05, 0x08, KEY_9)           /* ID: 10 */
		MATRIX_KEY(0x05, 0x0a, KEY_8)           /* ID: 9 */
		MATRIX_KEY(0x05, 0x0b, KEY_102ND)       /* ID: 45 */
		MATRIX_KEY(0x05, 0x0d, KEY_P)           /* ID: 26 */
		MATRIX_KEY(0x05, 0x0e, KEY_BACKSPACE)   /* ID: 15 */

		/* Row 6 */
		MATRIX_KEY(0x06, 0x04, KEY_F3)          /* ID: 114 */
		MATRIX_KEY(0x06, 0x05, KEY_W)           /* ID: 18 */
		MATRIX_KEY(0x06, 0x06, KEY_R)           /* ID: 20 */
		MATRIX_KEY(0x06, 0x07, KEY_U)           /* ID: 23 */
		MATRIX_KEY(0x06, 0x08, KEY_F11)         /* ID: 122 */
		MATRIX_KEY(0x06, 0x0a, KEY_I)           /* ID: 24 */
		MATRIX_KEY(0x06, 0x0b, KEY_LEFT)        /* ID: 79-1 */
		MATRIX_KEY(0x06, 0x0d, KEY_LEFTBRACE)   /* ID: 27 ([) */
		MATRIX_KEY(0x06, 0x0e, KEY_RIGHTBRACE)  /* ID: 28 (]) */

		/* Row 7 */
		MATRIX_KEY(0x07, 0x02, KEY_A)           /* ID: 31 */
		MATRIX_KEY(0x07, 0x05, KEY_ESC)         /* ID: 110 */
		MATRIX_KEY(0x07, 0x06, KEY_F)           /* ID: 34 */
		MATRIX_KEY(0x07, 0x07, KEY_J)           /* ID: 37 */
		MATRIX_KEY(0x07, 0x08, KEY_L)           /* ID: 39 */
		MATRIX_KEY(0x07, 0x0a, KEY_K)           /* ID: 38 */
		MATRIX_KEY(0x07, 0x0d, KEY_SEMICOLON)   /* ID: 40 */
		MATRIX_KEY(0x07, 0x0e, KEY_D)           /* ID: 33 */

		/*
		 * Fn layer (row + 8):
		 *  F1..F12 -> media/system keys when Fn is held.
		 */
		MATRIX_KEY(0x08, 0x01, KEY_INSERT)        /* Fn+Delete = Insert */
		MATRIX_KEY(0x09, 0x08, KEY_PAGEDOWN)      /* Fn+Down */
		MATRIX_KEY(0x09, 0x0d, KEY_PAGEUP)        /* Fn+Up */
		MATRIX_KEY(0x09, 0x0f, KEY_BRIGHTNESSUP)  /* Fn+F8 */
		MATRIX_KEY(0x0a, 0x05, KEY_VOLUMEDOWN)    /* Fn+F2 */
		MATRIX_KEY(0x0a, 0x0a, KEY_BRIGHTNESSDOWN) /* Fn+F7 */
		MATRIX_KEY(0x0a, 0x0f, KEY_END)           /* Fn+Right */
		MATRIX_KEY(0x0b, 0x04, KEY_PREVIOUSSONG)  /* Fn+F4 */
		MATRIX_KEY(0x0b, 0x05, KEY_MUTE)          /* Fn+F1 */
		MATRIX_KEY(0x0b, 0x0a, KEY_NEXTSONG)      /* Fn+F6 */
		MATRIX_KEY(0x0b, 0x0b, KEY_SWITCHVIDEOMODE) /* Fn+F9 */
		MATRIX_KEY(0x0b, 0x0d, KEY_CONFIG)        /* Fn+F12 */
		MATRIX_KEY(0x0c, 0x08, KEY_RFKILL)        /* Fn+F10 */
		MATRIX_KEY(0x0c, 0x0a, KEY_PLAYPAUSE)     /* Fn+F5 */
		MATRIX_KEY(0x0e, 0x04, KEY_VOLUMEUP)      /* Fn+F3 */
		MATRIX_KEY(0x0e, 0x08, KEY_SYSRQ)         /* Fn+F11 */
		MATRIX_KEY(0x0e, 0x0b, KEY_HOME)          /* Fn+Left */
		>;
	};
};
