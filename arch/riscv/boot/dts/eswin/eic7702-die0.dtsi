			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x50940000 0x0 0x10000>;
			interrupt-parent = <&d0_plic>;
			interrupts = <104>;
			clock-frequency = <DIE0_CLOCK_FREQ>;
			reg-io-width = <4>;
			reg-shift = <2>;
			numa-node-id = <0>;
		};

		d0_i2c0: i2c@50950000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x50950000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_LSP_I2C0_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_I2C0>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <105>;
			interrupt-parent = <&d0_plic>;
			numa-node-id = <0>;
			status = "disabled";
		};

		d0_i2c1: i2c@50960000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x50960000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_LSP_I2C1_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_I2C1>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <106>;
			interrupt-parent = <&d0_plic>;
			numa-node-id = <0>;
			status = "disabled";
		};

		d0_i2c2: i2c@50970000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x50970000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_LSP_I2C2_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_I2C2>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <107>;
			interrupt-parent = <&d0_plic>;
			numa-node-id = <0>;
			status = "disabled";
		};

		d0_i2c3: i2c@50980000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x50980000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_LSP_I2C3_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_I2C3>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <108>;
			interrupt-parent = <&d0_plic>;
			numa-node-id = <0>;
			status = "disabled";
		};

		d0_i2c4: i2c@50990000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x50990000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_LSP_I2C4_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_I2C4>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <109>;
			interrupt-parent = <&d0_plic>;
			numa-node-id = <0>;
			status = "disabled";
		};

		d0_i2c5: i2c@509a0000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x509a0000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_LSP_I2C5_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_I2C5>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <110>;
			interrupt-parent = <&d0_plic>;
			numa-node-id = <0>;
			status = "disabled";
		};

		d0_i2c6: i2c@509b0000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x509b0000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_LSP_I2C6_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_I2C6>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <111>;
			interrupt-parent = <&d0_plic>;
			numa-node-id = <0>;
			status = "disabled";
		};

		d0_i2c7: i2c@509c0000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x509c0000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_LSP_I2C7_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_I2C7>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <112>;
			interrupt-parent = <&d0_plic>;
			numa-node-id = <0>;
			status = "disabled";
		};

		d0_i2c8: i2c@509d0000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x509d0000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_LSP_I2C8_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_I2C8>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <113>;
			interrupt-parent = <&d0_plic>;
			numa-node-id = <0>;
			status = "disabled";
		};

		d0_i2c9: i2c@509e0000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x509e0000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_LSP_I2C9_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_I2C9>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <114>;
			interrupt-parent = <&d0_plic>;
			numa-node-id = <0>;
			status = "disabled";
		};

		d0_aon_i2c0: i2c@51830000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x51830000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_AON_I2C0_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_ANO0>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <290>;
			interrupt-parent = <&d0_plic>;
			numa-node-id = <0>;
		};

		d0_aon_i2c1: i2c@51838000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x51838000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_AON_I2C1_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_ANO1>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <291>;
			interrupt-parent = <&d0_plic>;
			numa-node-id = <0>;
		};

		d0_gpio: gpio@51600000 {
			compatible = "snps,dw-apb-gpio";
			reg = <0x0 0x51600000 0x0 0x80>;
			#address-cells = <1>;
			#size-cells = <0>;
			numa-node-id = <0>;

			d0_gpioA: gpio-port@0 {
				compatible = "snps,dw-apb-gpio-port";
				reg = <0>;
				interrupt-parent = <&d0_plic>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupts =
				<303>, <304>, <305>, <306>, <307>, <308>, <309>,
				<310>, <311>, <312>, <313>, <314>, <315>, <316>,
				<317>, <318>, <319>, <320>, <321>, <322>, <323>,
				<324>, <325>, <326>, <327>, <328>, <329>, <330>,
				<331>, <332>, <333>, <334>;
				gpio-controller;
				ngpios = <32>;
				#gpio-cells = <2>;
			};

			d0_gpioB: gpio-port@1 {
				compatible = "snps,dw-apb-gpio-port";
				reg = <1>;
				gpio-controller;
				ngpios = <32>;
				#gpio-cells = <2>;
			};

			d0_gpioC: gpio-port@2 {
				compatible = "snps,dw-apb-gpio-port";
				reg = <2>;
				gpio-controller;
				ngpios = <32>;
				#gpio-cells = <2>;
			};

			d0_gpioD: gpio-port@3 {
				compatible = "snps,dw-apb-gpio-port";
				reg = <3>;
				gpio-controller;
				ngpios = <16>;
				#gpio-cells = <2>;
			};
		};

		d0_pinctrl: pinctrl@51600080 {
			compatible = "eswin,eic7700-pinctrl", "syscon";
			reg = <0x0 0x51600080 0x0 0x1fff80>;
			numa-node-id = <0>;
		};

		d0_clocks: clock-controller@51828000 {
			compatible = "eswin,eic7700-clock";
			reg = <0x0 0x51828000 0x0 0x300>;
			#clock-cells = <1>;
			numa-node-id = <0>;
			clocks = <&d0_clock_24m>;
		};

		d0_reset: reset-controller@51828300 {
			compatible = "eswin,eic7700-reset";
			reg = <0x0 0x51828300 0x0 0x200>;
			#reset-cells = <1>;
			numa-node-id = <0>;
		};

		d0_d2d: d2d-unit@52100000 {
			compatible = "eswin,eic7700-d2d";
		};

		d0_ddr0: ddr-controller@52300000 {
			compatible = "eswin,ddrc-1.20a";
		};

		d0_ddr1: ddr-controller@52380000 {
			compatible = "eswin,ddrc-1.20a";
		};

		d0_pcie: pcie@54000000 {
			compatible = "eswin,eic7700-pcie";
			reg = <0x0 0x54000000 0x0 0x4000000>,
			      <0x0 0x40000000 0x0 0x800000>,
			      <0x0 0x50000000 0x0 0x100000>;
			reg-names = "dbi", "config", "elbi";
			ranges = <0x01000000 0x0 0x40800000 0x0 0x40800000 0x0 0x800000>,
				 <0x02000000 0x0 0x41000000 0x0 0x41000000 0x0 0xf000000>,
				 <0x43000000 0x80 0x00000000 0x80 0x00000000 0x2 0x00000000>;
			interrupt-parent = <&d0_plic>;
			interrupts = <220>, <179>, <180>, <181>, <182>, <183>, <184>, <185>, <186>;
			interrupt-names = "msi", "inta", "intb", "intc", "intd";
			interrupt-map-mask = <0x0 0x0 0x0 0x7>;
			interrupt-map = <0x0 0x0 0x0 0x1 &d0_plic 179>,
					<0x0 0x0 0x0 0x2 &d0_plic 180>,
					<0x0 0x0 0x0 0x3 &d0_plic 181>,
					<0x0 0x0 0x0 0x4 &d0_plic 182>;
			bus-range = <0x00 0xff>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_PCIET_ACLK>,
				 <&d0_clocks EIC7700_CLK_GATE_PCIET_CFG_CLK>,
				 <&d0_clocks EIC7700_CLK_GATE_PCIET_CR_CLK>,
				 <&d0_clocks EIC7700_CLK_GATE_PCIET_AUX_CLK>;
			clock-names = "mstr", "dbi", "phy_reg", "aux";
			device_type = "pci";
			#interrupt-cells = <1>;
			resets = <&d0_reset EIC7700_RESET_PCIE_CFG>,
				 <&d0_reset EIC7700_RESET_PCIE_POWEUP>;
			reset-names = "dbi", "pwr";
			#address-cells = <3>;
			#size-cells = <2>;
			numa-node-id = <0>;
			status = "disabled";

			pcie@0 {
				reg = <0x0 0x0 0x0 0x0 0x0>;
				ranges;
				device_type = "pci";
				num-lanes = <4>;
				resets = <&d0_reset EIC7700_RESET_PCIE_PERST>;
				reset-names = "perst";
				#address-cells = <3>;
				#size-cells = <2>;
			};
		};
	};
};



#include "eic7702-d0-pinctrl.dtsi"
