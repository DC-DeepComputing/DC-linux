#include <dt-bindings/riscv/physical-memory.h>
#include <dt-bindings/reset/eswin,eic7700-reset.h>
#include <dt-bindings/clock/eswin,eic7700-clock.h>
#include <dt-bindings/clock/eswin,eic7700-hspcrg.h>
#include <dt-bindings/reset/eswin,eic7700-hspcrg.h>
#include <dt-bindings/i2c/i2c.h>
#include <dt-bindings/gpio/gpio.h>

#define I2C_BITRATE_STANDARD    100000	/* 100 Kbit/s */
#define I2C_BITRATE_FAST        400000	/* 400 Kbit/s */
#define I2C_BITRATE_FAST_PLUS   1000000 /* 1 Mbit/s */
#define I2C_BITRATE_HIGH        3400000	/* 3.4 Mbit/s */
#define I2C_BITRATE_ULTRA       5000000 /* 5 Mbit/s */

#define DIE0_CLOCK_FREQ 200000000

/ {
	#address-cells = <2>;
	#size-cells = <2>;

	riscv,physical-memory-regions =
	<0x000 0x00000000 0x200 0x00000000 (PMA_RW | PMA_IO) 0x0>,
	<0x000 0x80000000 0x00f 0x80000000 (PMA_RWXA | PMA_NONCOHERENT_MEMORY) 0x0>,
	<0x0c0 0x00000000 0x010 0x00000000 (PMA_RWX | PMA_NONCACHEABLE_MEMORY | PMR_ALIAS(1)) 0x0>,
	<0x020 0x00000000 0x010 0x00000000 (PMA_RWXA | PMA_NONCOHERENT_MEMORY) 0x0>,
	<0x0e0 0x00000000 0x010 0x00000000 (PMA_RWX | PMA_NONCACHEABLE_MEMORY | PMR_ALIAS(3)) 0x0>;
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <1000000>;

		cpu-map {
			socket0 {
				cluster0 {
					core0 {
						cpu = <&cpu0>;
					};
					core1 {
						cpu = <&cpu1>;
					};
					core2 {
						cpu = <&cpu2>;
					};
					core3 {
						cpu = <&cpu3>;
					};
				};
			};

			socket1 {
				cluster1 {
					core0 {
						cpu = <&cpu4>;
					};
					core1 {
						cpu = <&cpu5>;
					};
					core2 {
						cpu = <&cpu6>;
					};
					core3 {
						cpu = <&cpu7>;
					};
				};
			};
		};

		cpu0: cpu@0 {
			compatible = "eswin,eic770x", "riscv";
			device_type = "cpu";
			d-cache-block-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <32>;
			i-cache-block-size = <64>;
			i-cache-sets = <128>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <32>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&d0_l2_cache_0>;
			reg = <0x0>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "sscofpmf",
					       "zba", "zbb", "zicsr", "zifencei";
			tlb-split;

			numa-node-id = <0>;
			cpu0_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		cpu1: cpu@1 {
			compatible = "eswin,eic770x", "riscv";
			d-cache-block-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <32>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <128>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <32>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&d0_l2_cache_1>;
			reg = <0x1>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "sscofpmf",
					       "zba", "zbb", "zicsr", "zifencei";
			tlb-split;

			numa-node-id = <0>;
			cpu1_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		cpu2: cpu@2 {
			compatible = "eswin,eic770x", "riscv";
			d-cache-block-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <32>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <128>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <32>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&d0_l2_cache_2>;
			reg = <0x2>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "sscofpmf",
					       "zba", "zbb", "zicsr", "zifencei";
			tlb-split;

			numa-node-id = <0>;
			cpu2_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		cpu3: cpu@3 {
			compatible = "eswin,eic770x", "riscv";
			d-cache-block-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <32>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <128>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <32>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&d0_l2_cache_3>;
			reg = <0x3>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "sscofpmf",
					       "zba", "zbb", "zicsr", "zifencei";
			tlb-split;

			numa-node-id = <0>;
			cpu3_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};

		d0_l2_cache_0: d0-l2-cache0 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <512>;
			cache-size = <262144>;
			cache-unified;
			next-level-cache = <&d0_ccache>;
			numa-node-id = <0>;
		};

		d0_l2_cache_1: d0-l2-cache1 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <512>;
			cache-size = <262144>;
			cache-unified;
			next-level-cache = <&d0_ccache>;
			numa-node-id = <0>;
		};

		d0_l2_cache_2: d0-l2-cache2 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <512>;
			cache-size = <262144>;
			cache-unified;
			next-level-cache = <&d0_ccache>;
			numa-node-id = <0>;
		};

		d0_l2_cache_3: d0-l2-cache3 {
			compatible = "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <512>;
			cache-size = <262144>;
			cache-unified;
			next-level-cache = <&d0_ccache>;
			numa-node-id = <0>;
		};
	};

	pmu {
		compatible = "riscv,pmu";
		riscv,event-to-mhpmcounters =
				<0x00001 0x00001 0x00000001>,
				<0x00002 0x00002 0x00000004>,
				<0x00004 0x00006 0x00000078>,
				<0x10009 0x10009 0x00000078>,
				<0x10019 0x10019 0x00000078>,
				<0x10021 0x10021 0x00000078>;
		riscv,event-to-mhpmevent =
				<0x00004 0x00000000 0x00000202>,
				<0x00005 0x00000000 0x00004000>,
				<0x00006 0x00000000 0x00002001>,
				<0x10009 0x00000000 0x00000102>,
				<0x10019 0x00000000 0x00001002>,
				<0x10021 0x00000000 0x00000802>;
		riscv,raw-event-to-mhpmcounters =
				<0x00000000 0x00000000 0xffffffff 0xfc0000ff 0x00000078>,
				<0x00000000 0x00000001 0xffffffff 0xfffe07ff 0x00000078>,
				<0x00000000 0x00000002 0xffffffff 0xfffe00ff 0x00000078>,
				<0x00000000 0x00000003 0xfffffffc 0x000000ff 0x00000078>,
				<0x00000000 0x00000004 0xffffffc0 0x000000ff 0x00000078>,
				<0x00000000 0x00000005 0xffffffff 0xfffffdff 0x00000078>,
				<0x00000000 0x00000006 0xfffffe00 0x110204ff 0x00000078>,
				<0x00000000 0x00000007 0xffffffff 0xf00000ff 0x00000078>,
				<0x00000000 0x00000008 0xfffffe04 0x000000ff 0x00000078>,
				<0x00000000 0x00000009 0xffffffff 0xffffc0ff 0x00000078>,
				<0x00000000 0x0000000a 0xffffffff 0xf00000ff 0x00000078>,
				<0x00000000 0x0000000b 0xffffffff 0xfffffcff 0x00000078>,
				<0x00000000 0x0000000c 0xfffffff0 0x000000ff 0x00000078>,
				<0x00000000 0x0000000d 0xffffffff 0x800000ff 0x00000078>,
				<0x00000000 0x0000000e 0xffffffff 0xf80000ff 0x00000078>,
				<0x00000000 0x0000000f 0xfffffffc 0x000000ff 0x00000078>;
	};

	d0_clock_24m: d0-clock-24m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
	};

	SOC:soc {
		compatible = "simple-bus";
		ranges;
		#address-cells = <2>;
		#size-cells = <2>;
		dma-noncoherent;

		clint: timer@2000000 {
			compatible = "eswin,eic7700-clint", "sifive,clint0";
			reg = <0x0 0x02000000 0x0 0x10000>;
			interrupts-extended =
			<&cpu0_intc 3>, <&cpu0_intc 7>,
			<&cpu1_intc 3>, <&cpu1_intc 7>,
			<&cpu2_intc 3>, <&cpu2_intc 7>,
			<&cpu3_intc 3>, <&cpu3_intc 7>;
			numa-node-id = <0>;
		};

		d0_ccache: cache-controller@2010000 {
			compatible = "eswin,eic7700-l3-cache", "sifive,ccache0", "cache";
			reg = <0x0 0x2010000 0x0 0x4000>;
			#address-cells = <2>;
			#size-cells = <2>;
			cache-block-size = <64>;
			cache-level = <3>;
			cache-sets = <4096>;
			cache-size = <4194304>;
			cache-unified;
			interrupts = <1>, <3>, <4>, <2>;
			interrupt-parent = <&d0_plic>;
			numa-node-id = <0>;
			ranges;
			zero-device@1a000000 {
				compatible = "l3,zero-device";
				reg = <0x0 0x1a000000 0x0 0x400000>;
			};
		};

		d0_plic: interrupt-controller@c000000 {
			compatible = "eswin,eic7700-plic", "sifive,plic-1.0.0";
			reg = <0x0 0xc000000 0x0 0x4000000>;
			interrupt-controller;
			interrupts-extended =
			<&cpu0_intc 11>, <&cpu0_intc 9>,
			<&cpu1_intc 11>, <&cpu1_intc 9>,
			<&cpu2_intc 11>, <&cpu2_intc 9>,
			<&cpu3_intc 11>, <&cpu3_intc 9>;
			riscv,ndev = <520>;
			#address-cells = <0>;
			#interrupt-cells = <1>;
			numa-node-id = <0>;
		};

		d0_hsp: bus@50400000 {
			compatible = "simple-pm-bus";
			ranges = <0x0 0x50400000 0x0 0x50400000 0x0 0xa0000>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_HSP_CFG_CLK>;
			#address-cells = <2>;
			#size-cells = <2>;

			d0_gmac0: ethernet@50400000 {
				compatible = "eswin,eic7700-qos-eth", "snps,dwmac-5.20";
				reg = <0x0 0x50400000 0x0 0x10000>;
				interrupts = <61>;
				interrupt-names = "macirq";
				interrupt-parent = <&d0_plic>;
				clocks = <&d0_clocks EIC7700_CLK_GATE_HSP_ACLK>,
					<&d0_clocks EIC7700_CLK_GATE_HSP_CFG_CLK>,
					<&d0_clocks EIC7700_CLK_MUX_SYSCFG_CLK_ROOT_2MUX1_GFREE>,
					<&d0_clocks EIC7700_CLK_GATE_HSP_ETH0_CORE_CLK>;
				clock-names = "axi", "cfg", "stmmaceth", "tx";
				resets = <&d0_reset EIC7700_RESET_HSP_ETH0_ARST>;
				reset-names = "stmmaceth";
				eswin,hsp-sp-csr = <&d0_hsp_sp_csr 0x100 0x108 0x118 0x114 0x11c>;
				snps,aal;
				snps,fixed-burst;
				snps,tso;
				snps,axi-config = <&d0_stmmac_axi_setup_gmac0>;
				numa-node-id = <0>;
				status = "disabled";

				d0_gmac0_mdio: mdio {
					compatible = "snps,dwmac-mdio";
					#address-cells = <1>;
					#size-cells = <0>;
				};

				d0_stmmac_axi_setup_gmac0: stmmac-axi-config {
					snps,blen = <0 0 0 0 16 8 4>;
					snps,rd_osr_lmt = <2>;
					snps,wr_osr_lmt = <2>;
				};
			};

			d0_gmac1: ethernet@50410000 {
				compatible = "eswin,eic7700-qos-eth-clk-inversion", "snps,dwmac-5.20";
				reg = <0x0 0x50410000 0x0 0x10000>;
				interrupts = <70>;
				interrupt-names = "macirq";
				interrupt-parent = <&d0_plic>;
				clocks = <&d0_clocks EIC7700_CLK_GATE_HSP_ACLK>,
					<&d0_clocks EIC7700_CLK_GATE_HSP_CFG_CLK>,
					<&d0_clocks EIC7700_CLK_MUX_SYSCFG_CLK_ROOT_2MUX1_GFREE>,
					<&d0_clocks EIC7700_CLK_GATE_HSP_ETH1_CORE_CLK>;
				clock-names = "axi", "cfg", "stmmaceth", "tx";
				resets = <&d0_reset EIC7700_RESET_HSP_ETH1_ARST>;
				reset-names = "stmmaceth";
				eswin,hsp-sp-csr = <&d0_hsp_sp_csr 0x200 0x208 0x218 0x214 0x21c>;
				snps,aal;
				snps,fixed-burst;
				snps,tso;
				snps,axi-config = <&d0_stmmac_axi_setup_gmac1>;
				numa-node-id = <0>;
				status = "disabled";

				d0_gmac1_mdio: mdio {
					compatible = "snps,dwmac-mdio";
					#address-cells = <1>;
					#size-cells = <0>;
				};

				d0_stmmac_axi_setup_gmac1: stmmac-axi-config {
					snps,blen = <0 0 0 0 16 8 4>;
					snps,rd_osr_lmt = <2>;
					snps,wr_osr_lmt = <2>;
				};
			};

			d0_sata: sata@50420000{
				compatible = "eswin,eic7700-ahci", "snps,dwc-ahci";
				reg = <0x0 0x50420000 0x0 0x10000>;
				interrupt-parent = <&d0_plic>;
				interrupts = <58>;
				clocks = <&d0_clocks EIC7700_CLK_GATE_HSP_CFG_CLK>,
						<&d0_clocks EIC7700_CLK_GATE_HSP_ACLK>;
				clock-names = "pclk", "aclk";
				phys = <&d0_sata_phy>;
				phy-names = "sata-phy";
				ports-implemented = <0x1>;
				resets = <&d0_reset EIC7700_RESET_SATA_ARST>;
				reset-names = "arst";
				numa-node-id = <0>;
				status = "disabled";
			};

			d0_sata_phy: sata-phy@50440300 {
				compatible = "eswin,eic7700-sata-phy";
				reg = <0x0 0x50440300 0x0 0x40>;
				clocks = <&d0_hspcrg EIC7700_HSP_CLK_GATE_SATA>;
				clock-names = "phy";
				resets = <&d0_hspcrg EIC7700_HSP_RST_SATA_P0>,
					 <&d0_hspcrg EIC7700_HSP_RST_SATA_PHY>;
				reset-names = "port", "phy";
				#phy-cells = <0>;
				numa-node-id = <0>;
			};

			d0_hsp_sp_csr: hsp-sp-top-csr@50440000 {
				compatible = "eswin,eic7700-syscfg", "syscon";
				reg = <0x0 0x50440000 0x0 0x2000>;
				numa-node-id = <0>;
			};

			d0_sdhci_emmc: mmc@50450000 {
				compatible = "eswin,eic7700-dwcmshc";
				reg = <0x0 0x50450000 0x0 0x10000>;
				interrupt-parent = <&d0_plic>;
				interrupts = <79>;
				assigned-clocks = <&d0_clocks EIC7700_CLK_GATE_HSP_MSHC0_CORE_CLK>;
				assigned-clock-rates = <200000000>;
				bus-width = <8>;
				clocks = <&d0_clocks EIC7700_CLK_GATE_HSP_MSHC0_CORE_CLK>,
						<&d0_clocks EIC7700_CLK_GATE_HSP_ACLK>;
				clock-names = "core", "bus";
				max-frequency = <200000000>;
				resets = <&d0_reset EIC7700_RESET_HSP_EMMC_ARST>,
					<&d0_reset EIC7700_RESET_MSHC0_PHY>,
					<&d0_reset EIC7700_RESET_HSP_EMMC_PRST>,
					<&d0_reset EIC7700_RESET_MSHC0_TXRX>;
				reset-names = "axi", "phy", "prstn", "txrx";
				eswin,hsp-sp-csr = <&d0_hsp_sp_csr 0x508 0x50c>;
				numa-node-id = <0>;
				status = "disabled";
			};

			d0_sdio0: mmc@50460000 {
				compatible = "eswin,eic7700-dwcmshc";
				reg = <0x0 0x50460000 0x0 0x10000>;
				interrupt-parent = <&d0_plic>;
				interrupts = <81>;
				bus-width = <4>;
				clocks = <&d0_clocks EIC7700_CLK_GATE_HSP_MSHC1_CORE_CLK>,
					 <&d0_clocks EIC7700_CLK_GATE_HSP_ACLK>;
				clock-names = "core", "bus";
				max-frequency = <208000000>;
				resets = <&d0_reset EIC7700_RESET_HSP_SD0_ARST>,
					 <&d0_reset EIC7700_RESET_MSHC1_PHY>,
					 <&d0_reset EIC7700_RESET_HSP_SD0_PRST>,
					 <&d0_reset EIC7700_RESET_MSHC1_TXRX>;
				reset-names = "axi", "phy", "prstn", "txrx";
				eswin,hsp-sp-csr = <&d0_hsp_sp_csr 0x608 0x60c>;
				numa-node-id = <0>;
				status = "disabled";
			};

			d0_sdio1: mmc@50470000 {
				compatible = "eswin,eic7700-dwcmshc";
				reg = <0x0 0x50470000 0x0 0x10000>;
				interrupt-parent = <&d0_plic>;
				interrupts = <83>;
				bus-width = <4>;
				clocks = <&d0_clocks EIC7700_CLK_GATE_HSP_MSHC2_CORE_CLK>,
					 <&d0_clocks EIC7700_CLK_GATE_HSP_ACLK>;
				clock-names = "core", "bus";
				max-frequency = <208000000>;
				resets = <&d0_reset EIC7700_RESET_HSP_SD1_ARST>,
					 <&d0_reset EIC7700_RESET_MSHC2_PHY>,
					 <&d0_reset EIC7700_RESET_HSP_SD1_PRST>,
					 <&d0_reset EIC7700_RESET_MSHC2_TXRX>;
				reset-names = "axi", "phy", "prstn", "txrx";
				eswin,hsp-sp-csr = <&d0_hsp_sp_csr 0x708 0x70c>;
				numa-node-id = <0>;
				status = "disabled";
			};

			d0_usb0: usb@50480000 {
				compatible = "eswin,eic7700-dwc3";
				reg = <0x0 0x50480000 0x0 0x10000>;
				interrupt-parent = <&d0_plic>;
				interrupts = <85>;
				interrupt-names = "peripheral";
				clocks = <&d0_clocks EIC7700_CLK_GATE_HSP_ACLK>,
					 <&d0_clocks EIC7700_CLK_GATE_HSP_CFG_CLK>,
					 <&d0_hspcrg EIC7700_HSP_CLK_GATE_USB0>;
				clock-names = "aclk", "cfg", "usb_en";
				dr_mode = "host";
				maximum-speed = "high-speed";
				phy_type = "utmi";
				resets = <&d0_reset EIC7700_RESET_USB0_VAUX>,
					 <&d0_hspcrg EIC7700_HSP_RST_USB0>,
					 <&d0_hspcrg EIC7700_HSP_RST_USB0_PHY>;
				reset-names = "vaux", "usb_rst", "usb_phy";
				eswin,hsp-sp-csr = <&d0_hsp_sp_csr 0x800 0x818>;
				numa-node-id = <0>;
				status = "disabled";
			};

			d0_usb1: usb@50490000 {
				compatible = "eswin,eic7700-dwc3";
				reg = <0x0 0x50490000 0x0 0x10000>;
				interrupt-parent = <&d0_plic>;
				interrupts = <86>;
				interrupt-names = "host";
				clocks = <&d0_clocks EIC7700_CLK_GATE_HSP_ACLK>,
					 <&d0_clocks EIC7700_CLK_GATE_HSP_CFG_CLK>,
					 <&d0_hspcrg EIC7700_HSP_CLK_GATE_USB1>;
				clock-names = "aclk", "cfg", "usb_en";
				dr_mode = "host";
				maximum-speed = "high-speed";
				phy_type = "utmi";
				resets = <&d0_reset EIC7700_RESET_USB1_VAUX>,
					 <&d0_hspcrg EIC7700_HSP_RST_USB1>,
					 <&d0_hspcrg EIC7700_HSP_RST_USB1_PHY>;
				reset-names = "vaux", "usb_rst", "usb_phy";
				eswin,hsp-sp-csr = <&d0_hsp_sp_csr 0x900 0x918>;
				numa-node-id = <0>;
				status = "disabled";
			};
		};

		d0_hspcrg: clock-controller@50440000 {
			compatible = "eswin,eic7700-hspcrg";
			reg = <0x0 0x50440000 0x0 0x2000>;
			clocks = <&d0_clocks EIC7700_CLK_GATE_HSP_CFG_CLK>,
				 <&d0_clocks EIC7700_CLK_FIXED_FACTOR_CLK_1M_DIV24>,
				 <&d0_clocks EIC7700_CLK_GATE_HSP_SATA_OOB_CLK>;
			clock-names = "cfg", "mmc", "sata";
			#clock-cells = <1>;
			#reset-cells = <1>;
			numa-node-id = <0>;
		};

		d0_wdt0: watchdog@50800000 {
			compatible = "snps,dw-wdt";
			reg = <0x0 0x50800000 0x0 0x4000>;
			interrupt-parent = <&d0_plic>;
			interrupts = <87>;
			clocks =<&d0_clocks EIC7700_CLK_GATE_LSP_WDT0_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_WDT0>;
			reset-names = "rst";
			numa-node-id = <0>;
			status = "disabled";
		};

		d0_wdt1: watchdog@50804000 {
			compatible = "snps,dw-wdt";
			reg = <0x0 0x50804000 0x0 0x4000>;
			interrupt-parent = <&d0_plic>;
			interrupts = <88>;
			clocks =<&d0_clocks EIC7700_CLK_GATE_LSP_WDT1_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_WDT1>;
			reset-names = "rst";
			numa-node-id = <0>;
			status = "disabled";
		};

		d0_wdt2: watchdog@50808000 {
			compatible = "snps,dw-wdt";
			reg = <0x0 0x50808000 0x0 0x4000>;
			interrupt-parent = <&d0_plic>;
			interrupts = <89>;
			clocks =<&d0_clocks EIC7700_CLK_GATE_LSP_WDT2_PCLK>;
			clock-names = "pclk";
			resets = <&d0_reset EIC7700_RESET_WDT2>;
			reset-names = "rst";
			numa-node-id = <0>;
			status = "disabled";
		};

		d0_wdt3: watchdog@5080c000 {
			compatible = "snps,dw-wdt";
			reg = <0x0 0x5080c000 0x0 0x4000>;
			interrupt-parent = <&d0_plic>;
			interrupts = <90>;
			clocks =<&d0_clocks EIC7700_CLK_GATE_LSP_WDT3_PCLK>;
			clock-names = "pclk";
