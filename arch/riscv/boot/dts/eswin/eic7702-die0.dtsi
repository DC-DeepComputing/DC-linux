			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x50930000 0x0 0x10000>;
			interrupt-parent = <&d0_plic>;
			interrupts = <103>;
			clock-frequency = <DIE0_CLOCK_FREQ>;
			reg-io-width = <4>;
