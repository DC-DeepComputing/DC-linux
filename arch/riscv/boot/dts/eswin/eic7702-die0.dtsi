			reset-names = "rst";
			numa-node-id = <0>;
			status = "disabled";
		};

		d0_uart0: serial@50900000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x50900000 0x0 0x10000>;
			interrupt-parent = <&d0_plic>;
			interrupts = <100>;
			clock-frequency = <DIE0_CLOCK_FREQ>;
			reg-io-width = <4>;
			reg-shift = <2>;
			numa-node-id = <0>;
		};

		d0_uart1: serial@50910000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x50910000 0x0 0x10000>;
			interrupt-parent = <&d0_plic>;
			interrupts = <101>;
			clock-frequency = <DIE0_CLOCK_FREQ>;
			reg-io-width = <4>;
			reg-shift = <2>;
			numa-node-id = <0>;

		};

		d0_uart2: serial@50920000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x50920000 0x0 0x10000>;
			interrupt-parent = <&d0_plic>;
			interrupts = <102>;
			clock-frequency = <DIE0_CLOCK_FREQ>;
			reg-io-width = <4>;
			reg-shift = <2>;
			numa-node-id = <0>;
		};

