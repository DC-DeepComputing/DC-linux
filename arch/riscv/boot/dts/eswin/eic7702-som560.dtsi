&d1_gmac1 {
	phy-handle = <&d1_gmac1_phy0>;
	phy-mode = "rgmii-id";
	pinctrl-names = "default";
	pinctrl-0 = <&d1_gpio34_pins>;
	rx-internal-delay-ps = <200>;
