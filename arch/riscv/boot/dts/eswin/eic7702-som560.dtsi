/dts-v1/;

#include "eic7702-die0.dtsi"
#include "eic7702-die1.dtsi"
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

#define RTCCLK_FREQ		1000000
#define LSPCLK_FREQ		200000000

/* If wanna enable ECC capability of DDR, should reserve highest zone of 1/8 all space for it */
#define MEMORY_SIZE_H		0x4
#define MEMORY_SIZE_L		0x0
#define CMA_SIZE		0x20000000

/ {
	model = "ESWIN EIC7702 SOM560";
	compatible = "eswin,eic7x";

	aliases {
		serial0 = &d0_uart0;
		ethernet0 = &d0_gmac0;
		ethernet1 = &d0_gmac1;
		ethernet2 = &d1_gmac0;
		ethernet3 = &d1_gmac1;
		mmc0 = &d0_sdhci_emmc;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyS0,115200 earlycon ";
	};

	cpus {
		timebase-frequency = <RTCCLK_FREQ>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 MEMORY_SIZE_H MEMORY_SIZE_L>;
		numa-node-id = <0>;
	};

	memory@2000000000 {
		device_type = "memory";
		reg = <0x20 0x00000000 MEMORY_SIZE_H MEMORY_SIZE_L>;
		numa-node-id = <1>;
	};

	distance-map {
		compatible = "numa-distance-map-v1";
		distance-matrix = <0 0 10>,
				<0 1 100>,
				<1 0 100>,
				<1 1 10>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 CMA_SIZE>;
			alignment = <0x0 0x1000>;
			alloc-ranges = <0x0 0x80000000 MEMORY_SIZE_H MEMORY_SIZE_L>;
			linux,cma-default;
		};

		nid_1_zero_device_simu: nid_1_zero_device_simu@2040000000 {
			no-map;
			reg = <0x20 0x40000000 0x0 0x400000>;
		};
	};

	vcc_1v8: regulator-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};
};

/* Register module nodes of Die0 */
&d0_dw_hdmi_hdcp2 {
	status = "okay";
};

&d0_dw_hdmi {
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			d0_hdmi_in_dc: endpoint@0 {
				remote-endpoint = <&d0_dc_out_hdmi>;
			};
		};
		/*
		port@2 {
			reg = <2>;
			d0_hdmi_in_i2s: endpoint@1 {
				system-clock-frequency = <12288000>;
				remote-endpoint = <&d0_i2s0_endpoint>;
			};
		};
		*/
	};
};

&d0_dc {
	status = "okay";
	d0_dc_out: port {
		#address-cells = <1>;
		#size-cells = <0>;
		d0_dc_out_dpi1: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&d0_vd_input>;
		};
		d0_dc_out_hdmi: endpoint@2 {
			reg = <2>;
			remote-endpoint = <&d0_hdmi_in_dc>;
		};
	};
};

&d0_dc_test {
	status = "disabled";
};

&d0_aon_i2c0 {
	/* unused */
	status = "disabled";
};

&d0_gmac0 {
	phy-handle = <&d0_gmac0_phy0>;
	phy-mode = "rgmii-id";
	pinctrl-names = "default";
	pinctrl-0 = <&d0_gpio29_pins>;
	rx-internal-delay-ps = <20>;
	tx-internal-delay-ps = <20>;
	status = "okay";
};

&d0_gmac0_mdio {
	d0_gmac0_phy0: ethernet-phy@0 {
		compatible = "ethernet-phy-id001c.c916";
		reg = <0>;
		reset-gpios = <&d0_gpioA 29 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <80000>;
	};
};

&d0_gmac1 {
	phy-handle = <&d0_gmac1_phy0>;
	phy-mode = "rgmii-id";
	pinctrl-names = "default";
	pinctrl-0 = <&d0_gpio34_pins>;
	rx-internal-delay-ps = <200>;
	tx-internal-delay-ps = <2100>;
	status = "okay";
};

&d0_gmac1_mdio {
	d0_gmac1_phy0: ethernet-phy@0 {
		compatible = "ethernet-phy-id001c.c916";
		reg = <0>;
		reset-gpios = <&d0_gpioB 2 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <80000>;
	};
};

&d0_aon_i2c1 {
	/* d2d vp pmic(5p49v6965) & temp sensor(tmp102) & d0 npu pmic(tps549d22) */
	status = "okay";
	tmp102@48 {
		compatible = "ti,tmp102";
		reg = <0x48>;
		label = "board_tmp";
		#thermal-sensor-cells = <1>;
	};

	tps549d22@10 {
		compatible = "ti,tps549d22";
		reg = <0x10>;
		eswin,regulator_default-microvolt=<1000000>;
		eswin,regulator_label = "Supply VDD", "D0 NPU Voltage";
		label = "npu_vdd";
		regulators{
			d0_npu_vcc:npu_svcc{
				regulator-name="D0_NPU_SVCC";
				regulator-min-microvolt=<700000>;
				regulator-max-microvolt=<1100000>;
				regulator-min-microamp=<20000000>;
				regulator-max-microamp=<40000000>;
				regulator-ov-protection-microvolt=<1100000>;
			};
		};
	};
};

&d0_pcie {
	status = "okay";
};

&d0_gpu {
	status = "okay";
};

&d0_gpio {
	status = "okay";
};

&d0_pinctrl {
	status = "okay";
	vrgmii-supply = <&vcc_1v8>;
};

&d0_sata {
	status = "okay";
};

&d0_sdhci_emmc {
	eswin,drive-impedance-ohms = <33>;
	mmc-hs400-1_8v;
	no-sd;
	no-sdio;
	non-removable;
	status = "okay";
};

&d0_sdio0 {
	status = "okay";
};

&d0_sdio1 {
	status = "disabled";
};

&d0_uart0 {
	/* debug */
	status = "okay";
};

&d0_uart1 {
	/* unused */
	status = "disabled";
};

&d0_uart2 {
	status = "okay";
};

&d0_uart3 {
	/* unused */
	status = "disabled";
};

&d0_uart4 {
	/* unused */
	status = "disabled";
};

&d0_usb0 {
	wakeup-source;
	snps,dis_enblslpm_quirk;
	snps,dis-u2-freeclk-exists-quirk;
	snps,dis_u2_susphy_quirk;
	snps,dis-del-phy-power-chg-quirk;
	snps,parkmode-disable-ss-quirk;
	status = "okay";
};

&d0_usb1 {
	wakeup-source;
	snps,dis_enblslpm_quirk;
	snps,dis-u2-freeclk-exists-quirk;
	snps,dis_u2_susphy_quirk;
	snps,dis-del-phy-power-chg-quirk;
	snps,parkmode-disable-ss-quirk;
	status = "okay";
};

&d0_wdt0 {
	status = "okay";
};

&d0_wdt1 {
	status = "okay";
};

&d0_wdt2 {
	status = "okay";
};

&d0_wdt3 {
	status = "okay";
};

&d0_reset {
	status = "okay";
};

&d0_d2d {
	status = "disabled";
};

&d0_ddr0 {
	status = "okay";
};

&d0_ddr1 {
	status = "okay";
};

&d0_video_output {
	status = "okay";
};

&d0_virtual_display {
	status = "okay";
	port {
		d0_vd_input: endpoint {
			remote-endpoint = <&d0_dc_out_dpi1>;
		};
	};
};

