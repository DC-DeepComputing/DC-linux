		d1_aon_i2c0: i2c@71830000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x71830000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d1_clocks EIC7700_CLK_GATE_AON_I2C0_PCLK>;
			clock-names = "pclk";
			resets = <&d1_reset EIC7700_RESET_ANO0>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <290>;
			interrupt-parent = <&d1_plic>;
			numa-node-id = <1>;
		};

		d1_aon_i2c1: i2c@71838000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x71838000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d1_clocks EIC7700_CLK_GATE_AON_I2C1_PCLK>;
			clock-names = "pclk";
			resets = <&d1_reset EIC7700_RESET_ANO1>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <291>;
			interrupt-parent = <&d1_plic>;
			numa-node-id = <1>;
		};

		d1_gpio: gpio@71600000 {
			compatible = "snps,dw-apb-gpio";
			reg = <0x0 0x71600000 0x0 0x80>;
			#address-cells = <1>;
			#size-cells = <0>;
			numa-node-id = <1>;

			d1_gpioA: gpio-port@0 {
				compatible = "snps,dw-apb-gpio-port";
				reg = <0>;
				interrupt-parent = <&d1_plic>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupts =
				<303>, <304>, <305>, <306>, <307>, <308>, <309>,
				<310>, <311>, <312>, <313>, <314>, <315>, <316>,
				<317>, <318>, <319>, <320>, <321>, <322>, <323>,
				<324>, <325>, <326>, <327>, <328>, <329>, <330>,
				<331>, <332>, <333>, <334>;
				pio-controller;
				ngpios = <32>;
				#gpio-cells = <2>;
			};

			d1_gpioB: gpio-port@1 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				ngpios = <32>;
				reg = <1>;
			};

			d1_gpioC: gpio-port@2 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				ngpios = <32>;
				reg = <2>;
			};

			d1_gpioD: gpio-port@3 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				ngpios = <16>;
				reg = <3>;
			};
		};

		d1_pinctrl: pinctrl@71600080 {
			compatible = "eswin,eic7700-pinctrl", "syscon";
			reg = <0x0 0x71600080 0x0 0x1fff80>;
			numa-node-id = <1>;
		};

		d1_clocks: clock-controller@71828000 {
			compatible = "eswin,eic7700-clock-d1";
			reg = <0x0 0x71828000 0x0 0x300>;
			#clock-cells = <1>;
			numa-node-id = <1>;
			clocks = <&d1_clock_24m>;
		};

		d1_reset: reset-controller@71828300 {
			compatible = "eswin,eic7700-reset";
			reg = <0x0 0x71828300 0x0 0x200>;
			#reset-cells = <1>;
			numa-node-id = <1>;
		};

		d1_d2d: d2d-unit@72100000 {
			compatible = "eswin,eic7x-d2d";
		};

		d1_ddr0: ddr-controller@72300000 {
			compatible = "eswin,ddrc-1.20a";
		};

		d1_ddr1: ddr-controller@72380000 {
			compatible = "eswin,ddrc-1.20a";
		};

		d1_pcie: pcie@74000000 {
			compatible = "eswin,eic7700-pcie";
			reg = <0x0 0x74000000 0x0 0x4000000>,
			      <0x0 0x60000000 0x0 0x800000>,
			      <0x0 0x70000000 0x0 0x100000>;
			reg-names = "dbi", "config", "elbi";
			ranges = <0x01000000 0x0 0x60800000 0x0 0x60800000 0x0 0x800000>,
				 <0x02000000 0x0 0x61000000 0x0 0x61000000 0x0 0xf000000>,
				 <0x43000000 0xa0 0x00000000 0xa0 0x00000000 0x2 0x00000000>;
			interrupt-parent = <&d1_plic>;
			interrupts = <220>, <179>, <180>, <181>, <182>, <183>, <184>, <185>, <186>;
			interrupt-names = "msi", "inta", "intb", "intc", "intd";
			interrupt-map-mask = <0x0 0x0 0x0 0x7>;
			interrupt-map = <0x0 0x0 0x0 0x1 &d1_plic 179>,
					<0x0 0x0 0x0 0x2 &d1_plic 180>,
					<0x0 0x0 0x0 0x3 &d1_plic 181>,
					<0x0 0x0 0x0 0x4 &d1_plic 182>;
			bus-range = <0x00 0xff>;
			clocks = <&d1_clocks EIC7700_CLK_GATE_PCIET_ACLK>,
				 <&d1_clocks EIC7700_CLK_GATE_PCIET_CFG_CLK>,
				 <&d1_clocks EIC7700_CLK_GATE_PCIET_CR_CLK>,
				 <&d1_clocks EIC7700_CLK_GATE_PCIET_AUX_CLK>;
			clock-names = "mstr", "dbi", "phy_reg", "aux";
			device_type = "pci";
			#interrupt-cells = <1>;
			resets = <&d1_reset EIC7700_RESET_PCIE_CFG>,
				 <&d1_reset EIC7700_RESET_PCIE_POWEUP>;
			reset-names = "dbi", "pwr";
			#address-cells = <3>;
			#size-cells = <2>;
			numa-node-id = <1>;
			status = "disabled";

			pcie@0 {
				reg = <0x0 0x0 0x0 0x0 0x0>;
				ranges;
				device_type = "pci";
				num-lanes = <4>;
				resets = <&d1_reset EIC7700_RESET_PCIE_PERST>;
				reset-names = "perst";
				#address-cells = <3>;
				#size-cells = <2>;
			};
		};
	};
};

#include "eic7702-d1-pinctrl.dtsi"
