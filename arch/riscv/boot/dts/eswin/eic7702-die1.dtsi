/ {
	cpus  {
		cpu4: cpu@4 {
			compatible = "eswin,eic770x", "riscv";
			d-cache-block-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <32>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <128>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <32>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&d1_l2_cache_0>;
			reg = <0x4>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "sscofpmf",
			"zba", "zbb", "zicsr", "zifencei";
			tlb-split;

			numa-node-id = <1>;
			cpu4_intc: interrupt-controller {
				#interrupt-cells = <1>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
			};

		};

		cpu5: cpu@5 {
			compatible = "eswin,eic770x", "riscv";
			d-cache-block-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <32>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <128>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <32>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&d1_l2_cache_1>;
			reg = <0x5>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "sscofpmf",
			"zba", "zbb", "zicsr", "zifencei";
			tlb-split;

			numa-node-id = <1>;
			cpu5_intc: interrupt-controller {
				#interrupt-cells = <1>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
			};

		};

		cpu6: cpu@6 {
			compatible = "eswin,eic770x", "riscv";
			d-cache-block-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <32>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <128>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <32>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&d1_l2_cache_2>;
			reg = <0x6>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "sscofpmf",
			"zba", "zbb", "zicsr", "zifencei";
			tlb-split;

			numa-node-id = <1>;
			cpu6_intc: interrupt-controller {
				#interrupt-cells = <1>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
			};

		};
		cpu7: cpu@7 {
			compatible = "eswin,eic770x", "riscv";
			d-cache-block-size = <64>;
			d-cache-sets = <128>;
			d-cache-size = <32768>;
			d-tlb-sets = <1>;
			d-tlb-size = <32>;
			device_type = "cpu";
			i-cache-block-size = <64>;
			i-cache-sets = <128>;
			i-cache-size = <32768>;
			i-tlb-sets = <1>;
			i-tlb-size = <32>;
			mmu-type = "riscv,sv48";
			next-level-cache = <&d1_l2_cache_3>;
			reg = <0x7>;
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "h", "sscofpmf",
			"zba", "zbb", "zicsr", "zifencei";
			tlb-split;

			numa-node-id = <1>;
			cpu7_intc: interrupt-controller {
				#interrupt-cells = <1>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
			};

		};

		d1_l2_cache_0: d1-l2-cache0 {
			compatible = "sifive,pL2Cache0", "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <512>;
			cache-size = <262144>;
			cache-unified;
			next-level-cache = <&d1_ccache>;
			numa-node-id = <1>;
		};
		d1_l2_cache_1: d1-l2-cache1 {
			compatible = "sifive,pL2Cache0", "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <512>;
			cache-size = <262144>;
			cache-unified;
			next-level-cache = <&d1_ccache>;
			numa-node-id = <1>;
		};
		d1_l2_cache_2: d1-l2-cache2 {
			compatible = "sifive,pL2Cache0", "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <512>;
			cache-size = <262144>;
			cache-unified;
			next-level-cache = <&d1_ccache>;
			numa-node-id = <1>;
		};
		d1_l2_cache_3: d1-l2-cache3 {
			compatible = "sifive,pL2Cache0", "cache";
			cache-block-size = <64>;
			cache-level = <2>;
			cache-sets = <512>;
			cache-size = <262144>;
			cache-unified;
			next-level-cache = <&d1_ccache>;
			numa-node-id = <1>;
		};
	};

	d1_clock_24m: d1-clock-24m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
	};

	soc {
		#address-cells = <2>;
		#size-cells = <2>;

		d1_ccache: cache-controller@22010000 {
			compatible = "eswin,eic7700-l3-cache", "sifive,ccache0", "cache";
			reg = <0x0 0x22010000 0x0 0x4000>;
			#address-cells = <2>;
			#size-cells = <2>;
			cache-block-size = <64>;
			cache-level = <3>;
			cache-sets = <4096>;
			cache-size = <4194304>;
			cache-unified;
			interrupts = <1>, <3>, <4>, <2>;
			interrupt-parent = <&d1_plic>;
			numa-node-id = <1>;
		};

		d1_plic: interrupt-controller@2c000000 {
			compatible = "sifive,plic-1.0.0";
			interrupt-controller;
			interrupts-extended = <
				&cpu4_intc 0xffffffff &cpu4_intc 9
				&cpu5_intc 0xffffffff &cpu5_intc 9
				&cpu6_intc 0xffffffff &cpu6_intc 9
				&cpu7_intc 0xffffffff &cpu7_intc 9
				>;
			reg = <0x0 0x2c000000 0x0 0x4000000>;
			reg-names = "control";
			riscv,ndev = <520>;
			riscv,max-priority = <7>;
			#interrupt-cells = <1>;
			numa-node-id = <1>;
		};

		d1_hsp: bus@70400000 {
			compatible = "simple-pm-bus";
			ranges = <0x0 0x70400000 0x0 0x70400000 0x0 0xa0000>;
			clocks = <&d1_clocks EIC7700_CLK_GATE_HSP_CFG_CLK>;
			#address-cells = <2>;
			#size-cells = <2>;

			d1_gmac0: ethernet@70400000 {
				compatible = "eswin,eic7700-qos-eth", "snps,dwmac-5.20";
				reg = <0x0 0x70400000 0x0 0x10000>;
				interrupts = <61>;
				interrupt-names = "macirq";
				interrupt-parent = <&d1_plic>;
				clocks = <&d1_clocks EIC7700_CLK_GATE_HSP_ACLK>,
					<&d1_clocks EIC7700_CLK_GATE_HSP_CFG_CLK>,
					<&d1_clocks EIC7700_CLK_MUX_SYSCFG_CLK_ROOT_2MUX1_GFREE>,
					<&d1_clocks EIC7700_CLK_GATE_HSP_ETH0_CORE_CLK>;
				clock-names = "axi", "cfg", "stmmaceth", "tx";
				resets = <&d1_reset EIC7700_RESET_HSP_ETH0_ARST>;
				reset-names = "stmmaceth";
				eswin,hsp-sp-csr = <&d1_hsp_sp_csr 0x100 0x108 0x118 0x114 0x11c>;
				snps,aal;
				snps,fixed-burst;
				snps,tso;
				snps,axi-config = <&d1_stmmac_axi_setup_gmac0>;
				numa-node-id = <1>;
				status = "disabled";

				d1_gmac0_mdio: mdio {
					compatible = "snps,dwmac-mdio";
					#address-cells = <1>;
					#size-cells = <0>;
				};

				d1_stmmac_axi_setup_gmac0: stmmac-axi-config {
					snps,blen = <0 0 0 0 16 8 4>;
					snps,rd_osr_lmt = <2>;
					snps,wr_osr_lmt = <2>;
				};
			};

			d1_gmac1: ethernet@70410000 {
				compatible = "eswin,eic7700-qos-eth-clk-inversion", "snps,dwmac-5.20";
				reg = <0x0 0x70410000 0x0 0x10000>;
				interrupts = <70>;
				interrupt-names = "macirq";
				interrupt-parent = <&d1_plic>;
				clocks = <&d1_clocks EIC7700_CLK_GATE_HSP_ACLK>,
					<&d1_clocks EIC7700_CLK_GATE_HSP_CFG_CLK>,
					<&d1_clocks EIC7700_CLK_MUX_SYSCFG_CLK_ROOT_2MUX1_GFREE>,
					<&d1_clocks EIC7700_CLK_GATE_HSP_ETH1_CORE_CLK>;
				clock-names = "axi", "cfg", "stmmaceth", "tx";
				resets = <&d1_reset EIC7700_RESET_HSP_ETH1_ARST>;
				reset-names = "stmmaceth";
				eswin,hsp-sp-csr = <&d1_hsp_sp_csr 0x200 0x208 0x218 0x214 0x21c>;
				snps,aal;
				snps,fixed-burst;
				snps,tso;
				snps,axi-config = <&d1_stmmac_axi_setup_gmac1>;
				numa-node-id = <1>;
				status = "disabled";

				d1_gmac1_mdio: mdio {
					compatible = "snps,dwmac-mdio";
					#address-cells = <1>;
					#size-cells = <0>;
				};

				d1_stmmac_axi_setup_gmac1: stmmac-axi-config {
					snps,blen = <0 0 0 0 16 8 4>;
					snps,rd_osr_lmt = <2>;
					snps,wr_osr_lmt = <2>;
				};
			};

			d1_sata: sata@70420000{
				compatible = "eswin,eic7700-ahci", "snps,dwc-ahci";
				reg = <0x0 0x70420000 0x0 0x10000>;
				interrupt-parent = <&d1_plic>;
				interrupts = <58>;
				clocks = <&d1_clocks EIC7700_CLK_GATE_HSP_CFG_CLK>,
						<&d1_clocks EIC7700_CLK_GATE_HSP_ACLK>;
				clock-names = "pclk", "aclk";
				phys = <&d1_sata_phy>;
				phy-names = "sata-phy";
				ports-implemented = <0x1>;
				resets = <&d1_reset EIC7700_RESET_SATA_ARST>;
				reset-names = "arst";
				numa-node-id = <1>;
				status = "disabled";
			};

			d1_sata_phy: sata-phy@70440300 {
				compatible = "eswin,eic7700-sata-phy";
				reg = <0x0 0x70440300 0x0 0x40>;
				clocks = <&d1_hspcrg EIC7700_HSP_CLK_GATE_SATA>;
				clock-names = "phy";
				resets = <&d1_hspcrg EIC7700_HSP_RST_SATA_P0>,
					 <&d1_hspcrg EIC7700_HSP_RST_SATA_PHY>;
				reset-names = "port", "phy";
				#phy-cells = <0>;
				numa-node-id = <1>;
			};

			d1_hsp_sp_csr: hsp-sp-top-csr@70440000 {
				compatible = "eswin,eic7700-syscfg", "syscon";
				reg = <0x0 0x70440000 0x0 0x2000>;
				numa-node-id = <1>;
			};

			d1_sdhci_emmc: mmc@70450000 {
				compatible = "eswin,eic7700-dwcmshc";
				reg = <0x0 0x70450000 0x0 0x10000>;
				interrupt-parent = <&d1_plic>;
				interrupts = <79>;
				assigned-clocks = <&d1_clocks EIC7700_CLK_GATE_HSP_MSHC0_CORE_CLK>;
				assigned-clock-rates = <200000000>;
				bus-width = <8>;
				clocks = <&d1_clocks EIC7700_CLK_GATE_HSP_MSHC0_CORE_CLK>,
						<&d1_clocks EIC7700_CLK_GATE_HSP_ACLK>;
				clock-names = "core", "bus";
				max-frequency = <200000000>;
				resets = <&d1_reset EIC7700_RESET_HSP_EMMC_ARST>,
					<&d1_reset EIC7700_RESET_MSHC0_PHY>,
					<&d1_reset EIC7700_RESET_HSP_EMMC_PRST>,
					<&d1_reset EIC7700_RESET_MSHC0_TXRX>;
				reset-names = "axi", "phy", "prstn", "txrx";
				eswin,hsp-sp-csr = <&d1_hsp_sp_csr 0x508 0x50c>;
				numa-node-id = <1>;
				status = "disabled";
			};

			d1_sdio0: mmc@70460000 {
				compatible = "eswin,eic7700-dwcmshc";
				reg = <0x0 0x70460000 0x0 0x10000>;
				interrupt-parent = <&d1_plic>;
				interrupts = <81>;
				bus-width = <4>;
				clocks = <&d1_clocks EIC7700_CLK_GATE_HSP_MSHC1_CORE_CLK>,
					 <&d1_clocks EIC7700_CLK_GATE_HSP_ACLK>;
				clock-names = "core", "bus";
				max-frequency = <208000000>;
				resets = <&d1_reset EIC7700_RESET_HSP_SD0_ARST>,
					 <&d1_reset EIC7700_RESET_MSHC1_PHY>,
					 <&d1_reset EIC7700_RESET_HSP_SD0_PRST>,
					 <&d1_reset EIC7700_RESET_MSHC1_TXRX>;
				reset-names = "axi", "phy", "prstn", "txrx";
				eswin,hsp-sp-csr = <&d1_hsp_sp_csr 0x608 0x60c>;
				numa-node-id = <1>;
				status = "disabled";
			};

			d1_sdio1: mmc@70470000 {
				compatible = "eswin,eic7700-dwcmshc";
				reg = <0x0 0x70470000 0x0 0x10000>;
				interrupt-parent = <&d1_plic>;
				interrupts = <83>;
				bus-width = <4>;
				clocks = <&d1_clocks EIC7700_CLK_GATE_HSP_MSHC2_CORE_CLK>,
					 <&d1_clocks EIC7700_CLK_GATE_HSP_ACLK>;
				clock-names = "core", "bus";
				max-frequency = <208000000>;
				resets = <&d1_reset EIC7700_RESET_HSP_SD1_ARST>,
					 <&d1_reset EIC7700_RESET_MSHC2_PHY>,
					 <&d1_reset EIC7700_RESET_HSP_SD1_PRST>,
					 <&d1_reset EIC7700_RESET_MSHC2_TXRX>;
				reset-names = "axi", "phy", "prstn", "txrx";
				eswin,hsp-sp-csr = <&d1_hsp_sp_csr 0x708 0x70c>;
				numa-node-id = <1>;
				status = "disabled";
			};

			d1_usb0: usb@70480000 {
				compatible = "eswin,eic7700-dwc3";
				reg = <0x0 0x70480000 0x0 0x10000>;
				interrupt-parent = <&d1_plic>;
				interrupts = <85>;
				interrupt-names = "peripheral";
				clocks = <&d1_clocks EIC7700_CLK_GATE_HSP_ACLK>,
					 <&d1_clocks EIC7700_CLK_GATE_HSP_CFG_CLK>,
					 <&d1_hspcrg EIC7700_HSP_CLK_GATE_USB0>;
				clock-names = "aclk", "cfg", "usb_en";
				dr_mode = "host";
				maximum-speed = "high-speed";
				phy_type = "utmi";
				resets = <&d1_reset EIC7700_RESET_USB0_VAUX>,
					 <&d1_hspcrg EIC7700_HSP_RST_USB0>,
					 <&d1_hspcrg EIC7700_HSP_RST_USB0_PHY>;
				reset-names = "vaux", "usb_rst", "usb_phy";
				eswin,hsp-sp-csr = <&d1_hsp_sp_csr 0x800 0x818>;
				numa-node-id = <1>;
				status = "disabled";
			};

			d1_usb1: usb@70490000 {
				compatible = "eswin,eic7700-dwc3";
				reg = <0x0 0x70490000 0x0 0x10000>;
				interrupt-parent = <&d1_plic>;
				interrupts = <86>;
				interrupt-names = "host";
				clocks = <&d1_clocks EIC7700_CLK_GATE_HSP_ACLK>,
					 <&d1_clocks EIC7700_CLK_GATE_HSP_CFG_CLK>,
					 <&d1_hspcrg EIC7700_HSP_CLK_GATE_USB1>;
				clock-names = "aclk", "cfg", "usb_en";
				dr_mode = "host";
				maximum-speed = "high-speed";
				phy_type = "utmi";
				resets = <&d1_reset EIC7700_RESET_USB1_VAUX>,
					 <&d1_hspcrg EIC7700_HSP_RST_USB1>,
					 <&d1_hspcrg EIC7700_HSP_RST_USB1_PHY>;
				reset-names = "vaux", "usb_rst", "usb_phy";
				eswin,hsp-sp-csr = <&d1_hsp_sp_csr 0x900 0x918>;
				numa-node-id = <1>;
				status = "disabled";
			};
		};

		d1_hspcrg: clock-controller@70440000 {
			compatible = "eswin,eic7700-hspcrg-d1";
			reg = <0x0 0x70440000 0x0 0x2000>;
			clocks = <&d1_clocks EIC7700_CLK_GATE_HSP_CFG_CLK>,
				 <&d1_clocks EIC7700_CLK_FIXED_FACTOR_CLK_1M_DIV24>,
				 <&d1_clocks EIC7700_CLK_GATE_HSP_SATA_OOB_CLK>;
			clock-names = "cfg", "mmc", "sata";
			#clock-cells = <1>;
			#reset-cells = <1>;
			numa-node-id = <1>;
		};

		d1_wdt0: watchdog@70800000 {
			compatible = "snps,dw-wdt";
			reg = <0x0 0x70800000 0x0 0x4000>;
			interrupt-parent = <&d1_plic>;
			interrupts = <87>;
			clocks =<&d1_clocks EIC7700_CLK_GATE_LSP_WDT0_PCLK>;
			clock-names = "pclk";
			resets = <&d1_reset EIC7700_RESET_WDT0>;
			reset-names = "rst";
			numa-node-id = <1>;
			status = "disabled";
		};

		d1_wdt1: watchdog@70804000 {
			compatible = "snps,dw-wdt";
			reg = <0x0 0x70804000 0x0 0x4000>;
			interrupt-parent = <&d1_plic>;
			interrupts = <88>;
			clocks =<&d1_clocks EIC7700_CLK_GATE_LSP_WDT1_PCLK>;
			clock-names = "pclk";
			resets = <&d1_reset EIC7700_RESET_WDT1>;
			reset-names = "rst";
			numa-node-id = <1>;
			status = "disabled";
		};

		d1_wdt2: watchdog@70808000 {
			compatible = "snps,dw-wdt";
			reg = <0x0 0x70808000 0x0 0x4000>;
			interrupt-parent = <&d1_plic>;
			interrupts = <89>;
			clocks =<&d1_clocks EIC7700_CLK_GATE_LSP_WDT2_PCLK>;
			clock-names = "pclk";
			resets = <&d1_reset EIC7700_RESET_WDT2>;
			reset-names = "rst";
			numa-node-id = <1>;
			status = "disabled";
		};

		d1_wdt3: watchdog@7080c000 {
			compatible = "snps,dw-wdt";
			reg = <0x0 0x7080c000 0x0 0x4000>;
			interrupt-parent = <&d1_plic>;
			interrupts = <90>;
			clocks =<&d1_clocks EIC7700_CLK_GATE_LSP_WDT3_PCLK>;
			clock-names = "pclk";
			resets = <&d1_reset EIC7700_RESET_WDT3>;
			reset-names = "rst";
			numa-node-id = <1>;
			status = "disabled";
		};

		d1_uart0: serial@70900000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x70900000 0x0 0x10000>;
			interrupt-parent = <&d1_plic>;
			interrupts = <100>;
			clock-frequency = <200000000>;
			reg-io-width = <4>;
			reg-shift = <2>;
			numa-node-id = <1>;
		};

		d1_uart1: serial@70910000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x70910000 0x0 0x10000>;
			interrupt-parent = <&d1_plic>;
			interrupts = <101>;
			clocks = <&d1_clocks EIC7700_CLK_GATE_LSP_UART1_PCLK>;
			clock-names = "apb_pclk";
			clock-frequency = <200000000>;
			resets = <&d1_reset EIC7700_RESET_UART1>;
			reg-io-width = <4>;
			reg-shift = <2>;
			numa-node-id = <1>;
		};

		d1_uart2: serial@70920000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x70920000 0x0 0x10000>;
			interrupt-parent = <&d1_plic>;
			interrupts = <102>;
			clock-frequency = <200000000>;
			reg-io-width = <4>;
			reg-shift = <2>;
			numa-node-id = <1>;
		};

		d1_uart3: serial@70930000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x70930000 0x0 0x10000>;
			interrupt-parent = <&d1_plic>;
			interrupts = <103>;
			clock-frequency = <200000000>;
			reg-io-width = <4>;
			reg-shift = <2>;
			numa-node-id = <1>;
		};

		d1_uart4: serial@70940000 {
			compatible = "snps,dw-apb-uart";
			reg = <0x0 0x70940000 0x0 0x10000>;
			interrupt-parent = <&d1_plic>;
			interrupts = <104>;
			clock-frequency = <200000000>;
			reg-io-width = <4>;
			reg-shift = <2>;
			numa-node-id = <1>;
		};

