			compatible = "snps,designware-i2c";
			reg = <0x0 0x70950000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d1_clocks EIC7700_CLK_GATE_LSP_I2C0_PCLK>;
			clock-names = "pclk";
			resets = <&d1_reset EIC7700_RESET_I2C0>;
			reset-names = "rst";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <105>;
			interrupt-parent = <&d1_plic>;
			status = "disabled";
			numa-node-id = <1>;
		};

