			compatible = "snps,designware-i2c";
			reg = <0x0 0x70960000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d1_clocks EIC7700_CLK_GATE_LSP_I2C1_PCLK>;
			clock-names = "pclk";
