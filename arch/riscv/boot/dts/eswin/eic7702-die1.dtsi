			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d1_clocks EIC7700_CLK_GATE_LSP_I2C8_PCLK>;
			clock-names = "pclk";
			resets = <&d1_reset EIC7700_RESET_I2C8>;
			reset-names = "rst";
