		d1_i2c6: i2c@709b0000 {
			compatible = "snps,designware-i2c";
			reg = <0x0 0x709b0000 0x0 0x8000>;
			clock-frequency = <I2C_BITRATE_STANDARD>;
			clocks = <&d1_clocks EIC7700_CLK_GATE_LSP_I2C6_PCLK>;
			clock-names = "pclk";
			resets = <&d1_reset EIC7700_RESET_I2C6>;
			reset-names = "rst";
			#address-cells = <1>;
